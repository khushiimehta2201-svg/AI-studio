# Existing local Ollama text model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_RETRIES=1
OLLAMA_NARRATION_ENABLED=true

# Existing local Ollama vision model
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Cursor grounding is a core requirement -- keep this ON.
# Only set to false as a temporary fallback on very low VRAM hardware.
OLLAMA_VISION_ENABLED=true
OLLAMA_VISION_TIMEOUT=45
OLLAMA_VISION_MAX_IMAGES=12
OLLAMA_VISION_MIN_CONFIDENCE=0.70

# Narration backend.
# NOTE: tts_service.py currently only implements two real backends:
#   sapi   -> Windows SAPI via PowerShell/System.Speech (this project's default)
#   kokoro -> local Kokoro-82M model (needs espeak-ng + model download)
# "azure", "auto", and "local_hinglish" are referenced in README/CHANGES.md
# but are NOT wired into tts_service._generate_one() in this branch -- setting
# them here will silently fall back to Kokoro. Implement those backends for
# real before relying on them, or keep using sapi.
TTS_PROVIDER=sapi

# Optional local Kokoro showcase backend (Apache 2.0) -- only used when
# TTS_PROVIDER=kokoro above.
KOKORO_LANGUAGE=en-us
KOKORO_VOICE=af_heart
