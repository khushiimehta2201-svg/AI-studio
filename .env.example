# ===================== SECURITY =====================
AUTH_REQUIRED=true
AUTH_SECRET=replace-with-a-long-random-secret
TRAINER_USERNAME=trainer
TRAINER_PASSWORD=change-me
TRAINEE_USERNAME=trainee
TRAINEE_PASSWORD=change-me
COOKIE_SECURE=true

# ===================== JOBS =========================
MAX_PDF_MB=200
GENERATION_WORKERS=1

# ===================== AI / OLLAMA ==================
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11435
AI_TEXT_MODEL=llama3.2
AI_VISION_MODEL=qwen2.5vl:7b
AI_NUM_CTX=4096
AI_TEXT_TIMEOUT=30
AI_VISION_TIMEOUT=45
AI_TEXT_RETRIES=1
AI_VISION_RETRIES=1
AI_BATCH_MAX_CHARS=7500

# Target confidence/routing policy
OCR_TARGET_CONFIDENCE=0.86
TARGET_AMBIGUITY_MARGIN=0.08
VISION_ACCEPT_CONFIDENCE=0.86
VISION_AMBIGUITY_MARGIN=0.08
VISION_SECOND_PASS=true
EVIDENCE_PAGE_WINDOW=2

# ===================== NARRATION ====================
NARRATION_LANGUAGE=en-us

# Local production-capable option when licensing/voice quality is approved.
TTS_PROVIDER=kokoro
KOKORO_LANGUAGE=a
TTS_VOICE=af_heart
AUTO_LOCAL_FALLBACK=false

# Optional Azure Speech provider
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=hi-IN-SwaraNeural
