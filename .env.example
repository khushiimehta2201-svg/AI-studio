# Existing local Ollama text model
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=20
OLLAMA_RETRIES=1
OLLAMA_NARRATION_ENABLED=true

# Existing local Ollama vision model
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Disabled by default on 4 GB GPUs. Enable only after installing a smaller vision model.
OLLAMA_VISION_ENABLED=false
OLLAMA_VISION_TIMEOUT=45
OLLAMA_VISION_MAX_IMAGES=12
OLLAMA_VISION_MIN_CONFIDENCE=0.70

# Production Hinglish TTS
TTS_PROVIDER=kokoro
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=hi-IN-SwaraNeural
AZURE_SPEECH_TIMEOUT=60

# Legacy local TTS option:
# TTS_PROVIDER=sapi
# Or use TTS_PROVIDER=auto to prefer Azure when credentials exist.

# Optional local Hinglish TTS demo backend (IndicF5 via hinglish-tts).
# Keep this backend in a separate Python 3.10/3.11 venv.
# Demo-only until commercial licensing is cleared.
# TTS_PROVIDER=local_hinglish
# HINGLISH_TTS_REPO=C:\path\to\hinglish-tts
# HINGLISH_REF_AUDIO=C:\path\to\hinglish-tts\data\reference_audio\tc_narrator.wav
# HINGLISH_REF_TEXT=C:\path\to\hinglish-tts\data\reference_audio\tc_narrator.txt
# HINGLISH_PYTHON=C:\path\to\hinglish-tts-venv\Scripts\python.exe
# HINGLISH_TTS_TIMEOUT=120
# HF_TOKEN=YOUR_HUGGINGFACE_READ_TOKEN


# Local Kokoro showcase backend (Apache 2.0)
# Select explicitly; it is intentionally not part of TTS_PROVIDER=auto.
# TTS_PROVIDER=kokoro
KOKORO_LANGUAGE=hinglish
KOKORO_VOICE=hf_alpha
# Supported UI languages: hinglish, hi, en-us, en-gb, es, fr, it, ja, pt-br, zh
# The web UI overrides KOKORO_LANGUAGE/KOKORO_VOICE per generation when Kokoro is selected.
